{
  "name": "guangying-writer",
  "productName": "光影写手",
  "version": "1.3.0-alpha.18.12",
  "description": "参考 Final Draft 的中文剧本创作软件",
  "main": "electron/main.js",
  "author": "WorkBuddy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron:dev": "electron .",
    "typecheck": "tsc --noEmit",
    "pack:mac": "bash package.sh",
    "dist": "bash package.sh",
    "test:render": "node scripts/render-test.cjs",
    "test:zhsp": "node scripts/zhsp-compat-test.cjs",
    "test:writing": "node scripts/writing-test.cjs",
    "test:history": "node scripts/history-test.cjs",
    "test:input": "node scripts/input-performance-test.cjs",
    "test:editing": "node scripts/editing-test.cjs",
    "test:quotes": "node scripts/smartquotes-test.cjs",
    "test:recovery": "node scripts/autosave-path-test.cjs && node scripts/autosave-recovery-test.cjs",
    "test:save": "node scripts/project-save-test.cjs && node scripts/project-save-ipc-test.cjs",
    "test:derivation": "node scripts/writing-derivation-test.cjs",
    "test:clipboard": "node scripts/clipboard-format-test.cjs && node scripts/clipboard-ui-test.cjs",
    "test:files": "node scripts/file-commands-test.cjs && node scripts/writing-range-integrity-test.cjs",
    "test:core": "node scripts/core-regression.cjs",
    "test:smarttype": "node scripts/smarttype-test.cjs && node scripts/smarttype-ui-test.cjs",
    "test:search": "node scripts/search-test.cjs && node scripts/search-ui-test.cjs",
    "test:board": "node scripts/board-workspace-model-test.cjs && node scripts/board-workspace-ui-test.cjs && node scripts/board-polish-test.cjs && node scripts/scene-notes-test.cjs",
    "smoke": "node scripts/run-smoke.cjs",
    "pack:win": "npm run build && node scripts/package-windows.cjs",
    "test:windows-package": "node scripts/windows-package-test.cjs",
    "test:windows": "node scripts/windows-smoke.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
